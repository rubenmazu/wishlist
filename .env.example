# Bază de date (Turso/libSQL)
# Local: lasă așa (fișier pe disc, fără token)
TURSO_DATABASE_URL=file:local.db
# Cloud (Turso): decomentează și completează
# TURSO_DATABASE_URL=libsql://numele-bazei-tale.turso.io
# TURSO_AUTH_TOKEN=token-ul-tau

# Secret pentru semnarea cookie-ului de sesiune.
# Generează unul: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=schimba-cu-un-secret-lung-aleatoriu

# Doar pentru scriptul de seed (creare utilizatori). Nu e nevoie în runtime.
MARTA_EMAIL=marta@wishlist.local
MARTA_PASSWORD=schimba-ma
RUBEN_EMAIL=ruben@wishlist.local
RUBEN_PASSWORD=schimba-ma
